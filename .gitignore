# Patterns without a leading slash match in every folder (web/, backend/, ...).

# docker
docker-compose.yml
Dockerfile

# dependencies
node_modules/
/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# python (backend)
.venv
__pycache__
.pytest_cache

# pipeline output (scraped data stays local)
data/

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*
!.env.example

# claude
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
